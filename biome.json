{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noArrayIndexKey": "warn",
				"noCommentText": "off"
			},
			"complexity": {
				"noImportantStyles": "warn"
			},
			"correctness": {
				"noUnknownTypeSelector": "off"
			},
			"a11y": {
				"noSvgWithoutTitle": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/components/ai-elements/**"],
			"linter": {
				"rules": {
					"performance": { "noImgElement": "off" },
					"suspicious": {
						"noExplicitAny": "off",
						"noArrayIndexKey": "off"
					},
					"complexity": { "useOptionalChain": "off" },
					"correctness": { "noUnusedImports": "off" }
				}
			}
		}
	]
}
